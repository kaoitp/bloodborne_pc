+void RecoverBbscHomeSpot(const BbscSaveSlot& slot) {
+    if (!BbscHomeRecoveryOn()) return;
+    const auto it = bbsc_own_world.find(Bbsc::HomeSpotKey);
+    if (it == bbsc_own_world.end()) return; // legacy journal has no return coordinates
+    const auto spot = Bbsc::DecodeHomeSpot(it->second);
+    if (!spot) return;
+    bbsc_home_spot = {spot->map, spot->position, spot->rotation, true, true, spot->lamp};
+    bbsc_home_recovery_slot = slot;
+    bbsc_home_recovery_requested = false;
+    bbsc_home_recovery_loaded = false;
+    bbsc_home_recovery_lamp = !Bbsc::FiniteHomePosition(*spot);
+    bbsc_home_recovery_ms = 0;
+    bbsc_home_recovery_arrival_ms = 0;
+    bbsc_home_recovery_stable_ms = 0;
+    bbsc_home_recovery_tries = 0;
+    LOG_INFO(Debug, "BBSC home recovery: user {} slot {} goes back to {:#x} ({}) after the crash",
