+void RecoverBbscHomeSpot(const BbscSaveSlot& slot) {
+    // shortcut: pending recovery across character selection is unsafe; enable after its native gate.
+    if (!Bbsc::HomeRecoveryEnabled(std::getenv("SHADPS4_BBSC_EXPERIMENTAL_HOME_RECOVERY"))) return;
+    const auto it = bbsc_own_world.find(Bbsc::HomeSpotKey);
+    if (it == bbsc_own_world.end()) return; // legacy journal has no return coordinates
+    const auto spot = Bbsc::DecodeHomeSpot(it->second);
+    if (!spot) return;
+    bbsc_home_spot = {spot->map, spot->position, spot->rotation, true, true, spot->lamp};
+    bbsc_home_recovery_slot = slot;
+    bbsc_home_recovery_requested = false;
+    bbsc_home_recovery_loaded = false;
+    bbsc_home_recovery_lamp = !Bbsc::FiniteHomePosition(*spot);
+    bbsc_home_recovery_ms = 0;
+}
+
+void SuspendBbscHomeRecovery() {
+    if (!bbsc_home_recovery_slot) return;
+    bbsc_home_recovery_slot.reset();
+    bbsc_home_spot.valid = false; // the journal stays on disk for its original character
+    bbsc_own_world.clear();
+    bbsc_own_world_slot.reset();
+}
+
+void TickBbscHomeRecovery() {
+    const u64 global = GetGlobalState();
+    const s64 now = SteadyNowMs();
+    if (!BbscHomeForOwnWorld() || !ReadablePointer(global, 0x1598)) return;
+    if (ReadValue<u8>(global, 0x08) != 0) return;
+    const auto here = ReadCharacterTransform(GetLocalPlayerCharacter());
+    if (!here || GetCharacterHp(GetLocalPlayerCharacter()) <= 0) return;
+    const u32 target = bbsc_home_recovery_lamp ? BbscLampPointMap(bbsc_home_spot.lamp)
+                                             : bbsc_home_spot.map;
+    if (!Bbsc::SupportedHomeMap(target)) return;
+    if (!bbsc_home_recovery_requested) {
+        if (now - bbsc_home_recovery_ms < 2'000) return;
+        bbsc_home_recovery_ms = now;
+        bbsc_home_recovery_requested = true;
+        bbsc_home_recovery_loaded = false;
+        if (bbsc_home_spot.lamp >= 1'000'000) {
+            WriteValue<s32>(global, 0x1528, bbsc_home_spot.lamp);
+        }
+        bool requested = false;
+        if (!bbsc_home_recovery_lamp) {
+            const SummonPlacementDescriptor to{target, bbsc_home_spot.position[0],
+                bbsc_home_spot.position[1], bbsc_home_spot.position[2],
+                bbsc_home_spot.rotation[1], -1};
+            requested = RequestBbscSessionWarp(global, to, "home recovery", false);
+        } else {
+            using Selector = bool PS4_SYSV_ABI (*)(u64, s32);
+            using Transition = u64 PS4_SYSV_ABI (*)();
+            WriteValue<u8>(global, 0x1520, 0);
+            requested = reinterpret_cast<Selector>(image_base + SelectSummonedPlacementOffset)(0, -1)
+                        && ReadValue<u32>(global, 0x0C) == target;
+            if (requested) reinterpret_cast<Transition>(image_base + StageTransitionOffset)();
+        }
+        bbsc_home_recovery_requested = requested;
+        LOG_INFO(Debug, "BBSC home recovery: requested {} into {:#x}, lamp {}, accepted {}",
+                 bbsc_home_recovery_lamp ? "recorded lamp" : "original point", target,
+                 bbsc_home_spot.lamp, requested);
+        return;
+    }
+    if (!bbsc_home_recovery_loaded || now - bbsc_home_recovery_ms < 2'000 ||
+        GetCurrentPackedMap() != target) return;
+    const float dx = here->position[0] - bbsc_home_spot.position[0];
+    const float dy = here->position[1] - bbsc_home_spot.position[1];
+    const float dz = here->position[2] - bbsc_home_spot.position[2];
+    if (!bbsc_home_recovery_lamp && dx * dx + dy * dy + dz * dz > 25.f) {
+        bbsc_home_recovery_lamp = true;
+        bbsc_home_recovery_requested = false;
+        return;
+    }
+    std::error_code ec;
+    const auto path = BbscOwnWorldPath(*bbsc_home_recovery_slot);
+    std::filesystem::rename(path, std::filesystem::path(path).concat(".restored"), ec);
+    if (ec) return; // keep recovery pending on a storage failure
+    LOG_INFO(Debug, "BBSC home recovery: own world and return point settled; journal retained as restored");
+    bbsc_home_recovery_slot.reset();
+    bbsc_home_spot.valid = false;
+}
