+// It is byte +0x1E2 bit 0x10, the bit the phantom-flags experiment (TickBbscReinsertV8,
+// 0x1001098 -> 0x1004098 at +0x1E1) cleared when it made the guest invisible.
+// For a while after each restart, a member character without it gets it, once.
+constexpr u32 BbscPlayerShownBit = 0x100000;
+constexpr s64 BbscRemoteShowWindowMs = 30'000;
+s64 bbsc_remote_show_until_ms = 0;
+
+void ArmBbscRemoteShow() {
+    bbsc_remote_show_until_ms = SteadyNowMs() + BbscRemoteShowWindowMs;
+}
+
+void TickBbscRemoteShow() {
+    if (bbsc_remote_show_until_ms == 0) {
+        return;
+    }
+    if (SteadyNowMs() > bbsc_remote_show_until_ms) {
+        bbsc_remote_show_until_ms = 0;
+        return;
+    }
+    const u64 global = GetGlobalState();
+    if (!ReadablePointer(global, 0x1521) || ReadValue<u8>(global, 0x08) != 0) {
+        return; // not while loading
+    }
+    for (const u64 task : GetMultiPlayerInsTasks()) {
+        const s32 mode = ReadValue<s32>(task, 0xE8);
+        if (mode != 1 && mode != 2) {
+            continue; // remote members only
+        }
+        const u64 player = FindRemotePlayerOf(task);
+        if (player == 0 || !HasMemoryAccess(player + 0x1E0, 4, MemoryProt::CpuWrite)) {
+            continue;
+        }
+        const u32 flags = ReadValue<u32>(player, 0x1E0);
+        if ((flags & BbscPlayerShownBit) != 0) {
+            continue;
+        }
+        WriteValue<u32>(player, 0x1E0, flags | BbscPlayerShownBit);
+        LOG_INFO(Debug, "BBSC reinsert: member character recreated without its shown bit "
+                        "(+0x1E0 {:#x}, mode {}) - set", flags, mode);
+        BBSC_TIMELINE("JOIN", "member character recreated hidden (+0x1E0 {:#x}) - shown again", flags);
+    }
 }
 
