+                                   "left as it is", event, owner.user, owner.slot);
+                return;
+            }
+            const bool saved = written->time_since_epoch().count() > since;
+            if (saved && !granted) {
+                LOG_WARNING(Debug, "BBSC boss drop: event {} of user {} slot {} - an earlier run's add "
+                                   "has no recorded outcome and the game saved after it: held until "
+                                   "its goods are seen in the inventory. If it was never delivered, "
+                                   "remove the line 'attempt {} ...' from {} to release it",
+                            event, owner.user, owner.slot, event,
+                            BbscBossRewardFilePath(owner).string());
+                BBSC_TIMELINE("BOSS", "boss drop: event {} from an earlier run - outcome unknown, held",
+                              event);
+                return;
+            }
+            if (SetBbscBossRewardLine(owner, event, saved ? "given" : "", 0)) {
+                LOG_INFO(Debug, "BBSC boss drop: event {} of user {} slot {} from an earlier run - {}",
+                         event, owner.user, owner.slot,
+                         saved ? "in its save, given" : "never saved, can be earned again");
+                BBSC_TIMELINE("BOSS", "boss drop: event {} from an earlier run - {}", event,
+                              saved ? "in its save, given" : "never saved, can be earned again");
