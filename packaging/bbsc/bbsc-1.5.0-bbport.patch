+    const HarderEnemies strength = rules.enemies.value_or(none);
+    return fmt::format("{},{},{},{},{},{:g},{:g},{:g}{}", rules.rot ? 1 : 0,
+                       rules.travel_together ? 1 : 0, rules.travel_vote ? 1 : 0,
