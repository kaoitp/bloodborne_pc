+#ifdef ORBIS_HTTP_WITH_HTTPLIB
+// Connections to a server are kept open and reused, as the PS4's HTTP library does (Supermedo's
+// bbport 1.9.8). Every call made a new connection (TCP, and TLS for https): two round trips or
+// more for each one. Far from the server the game froze for that long on the calls it waits for,
+// about once a minute (the emergency notice, the ghost upload). A client is taken out of the
+// pool for one request and put back only when the request worked; one key per server and
+// certificate choice.
+struct HttpClientPool {
+    std::mutex mutex;
+    std::unordered_map<std::string, std::vector<std::unique_ptr<httplib::Client>>> idle;
+};
+static HttpClientPool g_client_pool;
+constexpr size_t kIdleClientsPerKey = 4;
+
+class PooledHttpClient {
+public:
+    PooledHttpClient(std::string key, const std::string& base_url) : key_(std::move(key)) {
+        {
+            std::scoped_lock lock{g_client_pool.mutex};
+            auto& list = g_client_pool.idle[key_];
+            if (!list.empty()) {
+                client_ = std::move(list.back());
+                list.pop_back();
+                reused_ = true;
+            }
+        }
+        if (!client_) {
+            client_ = std::make_unique<httplib::Client>(base_url);
+        }
+        client_->set_keep_alive(true);
+    }
+    ~PooledHttpClient() {
+        if (!worked_ || !client_) {
+            return; // a failed connection is not reused
+        }
+        std::scoped_lock lock{g_client_pool.mutex};
+        auto& list = g_client_pool.idle[key_];
+        if (list.size() < kIdleClientsPerKey) {
+            list.push_back(std::move(client_));
+        }
+    }
+    httplib::Client& operator*() {
+        return *client_;
+    }
+    bool reused() const {
+        return reused_;
+    }
+    void worked() {
+        worked_ = true;
+    }
+
+private:
+    std::string key_;
+    std::unique_ptr<httplib::Client> client_;
+    bool reused_ = false;
+    bool worked_ = false;
+};
+#endif
